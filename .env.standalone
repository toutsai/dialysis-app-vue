# --- 單機離線模式 (npm run dev:standalone / npm run build:standalone) ---
# 連接到本地後端伺服器，不使用 Firebase

# 標記為單機模式
VITE_APP_ENV=standalone

# 本地 API 伺服器位址
VITE_LOCAL_API_URL=http://localhost:3000/api

# 禁用 Firebase (這些值不會被使用，但需要存在以避免錯誤)
VITE_FIREBASE_API_KEY=not-used
VITE_FIREBASE_AUTH_DOMAIN=not-used
VITE_FIREBASE_PROJECT_ID=not-used
VITE_FIREBASE_STORAGE_BUCKET=not-used
VITE_FIREBASE_MESSAGING_SENDER_ID=not-used
VITE_FIREBASE_APP_ID=not-used
