rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions (保持您原有的，非常棒！) ---
    function isAuthenticated() {
      return request.auth != null;
    }
    function getUserRole() {
      return request.auth.token.role;
    }
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }
    function isEditor() {
      let role = getUserRole();
      return isAuthenticated() && (role == 'admin' || role == 'editor');
    }
    function isContributor() {
      let role = getUserRole();
      return isAuthenticated() && (role == 'admin' || role == 'editor' || role == 'contributor');
    }

    // --- 各個集合的規則 (原有規則保持不變) ---
    match /users/{userId} {
      allow list: if isAdmin();
      allow get: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow write: if isAdmin(); 
    }
    match /patients/{patientId} {
      allow read: if isAuthenticated();
      allow create, update: if isContributor();
      allow delete: if isEditor();
    }
    match /schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow write: if isEditor();
    }
    match /base_schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow write: if isEditor();
    }
    match /memos/{memoId} {
      allow read, write: if isAuthenticated();
    }
    
    // ✨ --- 核心修正點 1：修改例外管理規則 --- ✨
    match /schedule_exceptions/{exceptionId} {
      // ✅ 修正：允許所有已登入的使用者讀取此集合，以便 useConflictWatcher 正常工作
      allow read: if isAuthenticated();
      
      // 保持原有的嚴格寫入權限
      allow create, delete: if isEditor();

      // 保持不允許客戶端直接更新
      allow update: if false; 
    }
    
    match /exception_tasks/{taskId} {
      // 保持後端專用
      allow read, write: if false;
    }
    // ✨ --- 結束修正 --- ✨

    // ✨ --- 核心修正點 2：新增 notifications 集合規則 --- ✨
    match /notifications/{notificationId} {
      // 允許所有已登入的使用者讀取（接收）通知
      allow read: if isAuthenticated();

      // 允許所有已登入的使用者創建（發送）通知
      allow create: if isAuthenticated();
      
      // 不允許任何人從前端修改或刪除通知（刪除由後台 TTL 政策處理）
      allow update, delete: if false;
    }
    // ✨ --- 結束新增 --- ✨

    match /dialysis_orders_history/{historyId} {
      allow read: if isAuthenticated();
      allow create: if isContributor();
      allow update: if isEditor();
      allow delete: if isEditor();
    }
    match /patient_history/{historyId} {
      allow read: if isAuthenticated();
      allow create: if isContributor();
      allow update: if isEditor();
      allow delete: if isEditor();
    }
  }
}