rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions (保持不變) ---
    function isAuthenticated() {
      return request.auth != null;
    }
    function getUserRole() {
      return request.auth.token.role;
    }
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }
    function isEditor() {
      let role = getUserRole();
      return isAuthenticated() && (role == 'admin' || role == 'editor');
    }
    function isContributor() {
      let role = getUserRole();
      return isAuthenticated() && (role == 'admin' || role == 'editor' || role == 'contributor');
    }

    // --- 各個集合的規則 (原有規則保持不變) ---
    match /users/{userId} {
      allow list: if isAdmin();
      allow get: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow write: if isAdmin(); 
    }
    match /patients/{patientId} {
      allow read: if isAuthenticated();
      allow create, update: if isContributor();
      allow delete: if isEditor();
    }
    match /schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow write: if isEditor();
    }
    match /base_schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow write: if isEditor();
    }
    match /memos/{memoId} {
      allow read, write: if isAuthenticated();
    }
    
    match /schedule_exceptions/{exceptionId} {
      allow read: if isAuthenticated();
      allow create, delete: if isEditor();
      allow update: if false; 
    }
    
    match /exception_tasks/{taskId} {
      allow read, write: if false;
    }
    
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /dialysis_orders_history/{historyId} {
      allow read: if isAuthenticated();
      allow create: if isContributor();
      allow update: if isEditor();
      allow delete: if isEditor();
    }
    match /patient_history/{historyId} {
      allow read: if isAuthenticated();
      allow create: if isContributor();
      allow update: if isEditor();
      allow delete: if isEditor();
    }
    match /condition_records/{recordId} {
      allow read: if isAuthenticated();
      allow write: if isContributor();
    }
    match /lab_reports/{reportId} {
      // 允許所有已登入的使用者讀取檢驗報告
      allow read: if isAuthenticated();
      // 只有後端函式可以寫入，前端不允許直接寫入
      allow write: if false; 
    }
    match /nurse_assignments/{date} {
      allow read: if isAuthenticated();
      allow write: if isEditor(); // 或只允許 Cloud Functions 寫入
    }
    // ==========================================================
    // ✨ 新增：每日日誌 (Daily Logs) 的安全規則
    // ==========================================================
    match /daily_logs/{logId} {
      // 允許 admin, editor, contributor 角色讀取和寫入
      // 文件 ID (logId) 必須是 YYYY-MM-DD 的格式
      allow read, write: if request.auth != null &&
                           request.auth.token.role in ['admin', 'editor'] &&
                           logId.matches('^\\d{4}-\\d{2}-\\d{2}$');

      // 允許 authenticated 使用者讀取 (如果未來需要開放給一般使用者查看)
      // allow read: if request.auth != null;
    }

  }
}