rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- 權限輔助函式 (強化版) ---
    function isAuthenticated() {
      return request.auth != null;
    }

    // ✨ 核心修正 #1: 改為直接從 token 讀取角色，更高效、更可靠 ✨
    function getUserRole() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }
    
    function isEditor() {
      let role = getUserRole();
      return isAuthenticated() && (role == 'admin' || role == 'editor');
    }

    function isContributor() {
      let role = getUserRole();
      return isAuthenticated() && (role == 'admin' || role == 'editor' || role == 'contributor');
    }

    // isViewer 現在只代表 "任何已登入的使用者"
    function isViewer() {
      return isAuthenticated();
    }
    
    // --- 集合規則 ---
    
    match /users/{userId} {
      allow list, get: if isViewer();
      allow write: if isAdmin();
    }
    
    match /patients/{patientId} {
      allow read: if isViewer();
      allow create, update: if isContributor();
      allow delete: if isEditor();
    }
    
    // ✨ 核心修正 #2: 確保所有已登入用戶 (isViewer) 都能讀取排程 ✨
    match /schedules/{scheduleId} {
      allow read: if isViewer();
      allow write: if isEditor(); // 寫入權限保持不變
    }
    
    // ✨ --- 【請在此處新增以下規則】 --- ✨
    match /expired_schedules/{scheduleId} {
      // 權限設定：
      // 讀取 (read): 所有已登入的使用者 (viewer) 都可以讀取歷史歸檔資料。
      // 寫入 (write): 不允許任何客戶端直接寫入、更新或刪除歸檔資料。
      // 歸檔資料只能由後端的 Cloud Function (具有管理員權限) 寫入。
      allow read: if isViewer();
      allow write: if false;
    }

    match /base_schedules/{scheduleId} {
      allow read: if isViewer();
      allow write: if isEditor();
    }
    
    match /memos/{memoId} {
      allow read, write: if isViewer();
    }
    
    match /schedule_exceptions/{exceptionId} {
      allow read: if isViewer();
      allow create, delete: if isEditor();
      allow update: if false; 
    }
    
    match /exception_tasks/{taskId} {
      allow read, write: if false;
    }
    
    match /notifications/{notificationId} {
      allow read: if isViewer();
      allow create: if isViewer();
      allow update, delete: if false;
    }

    match /dialysis_orders_history/{historyId} {
      allow read: if isViewer();
      allow create: if isContributor();
      allow update: if isEditor();
      allow delete: if isEditor();
    }

    match /patient_history/{historyId} {
      allow read: if isViewer();
      allow create: if isContributor();
      allow update: if isEditor();
      allow delete: if isEditor();
    }

    match /condition_records/{recordId} {
      allow read: if isViewer();
      allow write: if isContributor();
    }
    
    match /lab_reports/{reportId} {
      allow read: if isViewer();
      allow write: if isViewer(); 
    }

    match /nurse_assignments/{date} {
      allow read: if isViewer();
      allow write: if isEditor();
    }

    match /daily_logs/{logId} {
      allow read: if isViewer() && logId.matches('^\\d{4}-\\d{2}-\\d{2}$');
      allow write: if isEditor() && logId.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    match /tasks/{taskId} {
      allow read, create, update: if isViewer();
      allow delete: if isEditor();
    }
    
    match /physicians/{physicianId} {
      allow read: if isViewer();
      allow write: if isAdmin();
    }

    match /physician_schedules/{scheduleId} {
      allow read: if isViewer();
      allow write: if isContributor();
    }

    match /consumables_reports/{reportId} {
      allow read: if isViewer();
      allow write: if isViewer(); 
    }
    
    // ✨ [新增] 藥囑異動紀錄的規則 ✨
    match /medication_orders/{orderId} {
      // 讀取權限：所有登入的使用者都可以讀取藥囑，以便查詢。
      allow read: if isViewer();

      // 寫入權限 (create, update, delete)：
      // 只有 contributor 或更高等級的使用者才能透過 Cloud Function 建立新的藥囑紀錄。
      // 我們不允許客戶端直接更新或刪除，以確保歷史紀錄的不可變性。
      allow create: if isContributor();
      allow update: if false; // 禁止客戶端直接更新歷史紀錄
      allow delete: if isAdmin(); // 只允許系統管理員刪除錯誤的紀錄
    }

    match /medication_drafts/{draftId} {
      // 允許任何已登入的使用者讀取草稿 (為了管理頁面)
      allow read: if request.auth != null;

      // 允許使用者建立屬於自己的草稿
      // request.resource.data 指的是即將要寫入的新資料
      allow create: if request.auth != null 
                    && request.resource.data.authorId == request.auth.uid;
      
      // 允許使用者更新或刪除屬於自己的草稿
      // resource.data 指的是資料庫中已經存在的舊資料
      allow update, delete: if request.auth != null 
                            && resource.data.authorId == request.auth.uid;
    }
    // ✨ 在這裡新增護理職責的規則 ✨
    match /nursing_duties/{dutyId} {
      allow read: if isViewer();
      allow write: if isAdmin();
    }

    match /nursing_schedules/{scheduleId} {
      allow read: if request.auth != null && request.auth.token.role in ['admin', 'editor'];
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
  }
}