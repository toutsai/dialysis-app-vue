rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- 輔助函式 ---
    function isAuthenticated() {
      return request.auth != null;
    }

    // ✨ 核心優化：getUserRole 函式 ✨
    // 這個版本更健壯，它會優先從 Auth Token 讀取角色（速度快），
    // 如果 Token 中因故沒有角色資訊（例如舊的 Token），它會回頭去 Firestore 讀取。
    // 這確保了在任何情況下都能拿到正確的角色。
    function getUserRole() {
      return request.auth.token.role || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isEditor() {
      let role = getUserRole();
      return isAuthenticated() && (role == 'admin' || role == 'editor');
    }

    function isContributor() {
      let role = getUserRole();
      return isAuthenticated() && (role == 'admin' || role == 'editor' || role == 'contributor');
    }

    // --- 各個集合的規則 (完全保留你的原始邏輯) ---
    match /users/{userId} {
      allow list: if isAdmin();
      allow get: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      // ✨ 修正：allow write 改為 allow create, update, delete，並細化 update 規則 ✨
      // 這樣可以防止使用者自己修改自己的角色
      allow create, delete: if isAdmin();
      allow update: if (isAdmin() || (isAuthenticated() && request.auth.uid == userId)) &&
                     !('role' in request.resource.data); // 不允許非 admin 修改角色
    }

    match /patients/{patientId} {
      allow read: if isAuthenticated();
      allow create, update: if isContributor();
      allow delete: if isEditor();
    }

    match /schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow write: if isEditor();
    }

    match /base_schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow write: if isEditor();
    }

    match /memos/{memoId} {
      allow read, write: if isAuthenticated();
    }
    
    match /schedule_exceptions/{exceptionId} {
      allow read: if isAuthenticated();
      allow create, delete: if isEditor();
      allow update: if false; 
    }
    
    match /exception_tasks/{taskId} {
      allow read, write: if false;
    }
    
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /dialysis_orders_history/{historyId} {
      allow read: if isAuthenticated();
      allow create: if isContributor();
      allow update: if isEditor();
      allow delete: if isEditor();
    }

    match /patient_history/{historyId} {
      allow read: if isAuthenticated();
      allow create: if isContributor();
      allow update: if isEditor();
      allow delete: if isEditor();
    }

    match /condition_records/{recordId} {
      allow read: if isAuthenticated();
      allow write: if isContributor();
    }

    match /lab_reports/{reportId} {
      allow read: if isAuthenticated();
      allow write: if false; 
    }

    match /nurse_assignments/{date} {
      allow read: if isAuthenticated();
      allow write: if isEditor();
    }

    match /daily_logs/{logId} {
      allow read: if request.auth != null && logId.matches('^\\d{4}-\\d{2}-\\d{2}$');
      allow write: if request.auth != null &&
                      getUserRole() in ['admin', 'editor'] &&
                      logId.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    match /tasks/{taskId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isEditor();
    }
    
    match /physicians/{physicianId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /physician_schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow write: if request.auth != null && 
                     getUserRole() in ['admin', 'contributor'];
    }
  }
}