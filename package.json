{
  "name": "dialysis-app-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "// --- 開發與建構 ---": "",
    "prebuild": "node ./scripts/generate-changelog.cjs",
    "prebuild:dev": "node ./scripts/generate-changelog.cjs",
    "dev": "vite --mode emulator",
    "build": "tsc -b && vite build --mode production",
    "build:dev": "tsc -b && vite build --mode development",
    "preview": "vite preview",
    "generate-changelog": "node ./scripts/generate-changelog.cjs",
    "// --- 程式碼品質 ---": "",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "type-check": "tsc --noEmit",
    "// --- 模擬器與資料填充 ---": "",
    "emu": "firebase emulators:start --project develop --only firestore,auth,functions",
    "seed": "node ./scripts/seed-firestore.cjs",
    "// --- 部署指令 (開發環境) ---": "",
    "deploy:hosting:dev": "firebase deploy --project develop --only hosting",
    "deploy:functions:dev": "firebase deploy --project develop --only functions",
    "deploy:rules:dev": "firebase deploy --project develop --only firestore:rules",
    "// --- 部署指令 (生產環境) ---": "",
    "deploy:hosting:prod": "firebase deploy --project production --only hosting",
    "deploy:functions:prod": "firebase deploy --project production --only functions",
    "deploy:rules:prod": "firebase deploy --project production --only firestore:rules",
    "// --- 一鍵部署套餐 ---": "",
    "deploy:dev": "npm-run-all build:dev deploy:hosting:dev deploy:functions:dev deploy:rules:dev",
    "deploy:prod": "npm-run-all build deploy:hosting:prod deploy:functions:prod deploy:rules:prod"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/list": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "axios": "^1.11.0",
    "dompurify": "^3.3.0",
    "firebase": "^12.3.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-quill-new": "^3.3.0",
    "react-router-dom": "^7.1.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@faker-js/faker": "^9.9.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.17.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "dotenv": "^17.2.1",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "firebase-admin": "^13.4.0",
    "globals": "^16.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "3.5.3",
    "typescript": "^5.6.3",
    "vite": "^6.2.4"
  }
}
