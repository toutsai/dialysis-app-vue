{
  "name": "dialysis-app-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "// --- 開發與建構 (已根據您的命名習慣修正) ---": "",
    "dev": "vite --mode local",
    "build": "vite build --mode production",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "// --- 程式碼品質 ---": "",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "// --- 獨立的部署指令 (開發環境) ---": "",
    "deploy:hosting:dev": "firebase deploy --project develop --only hosting:develop",
    "deploy:functions:dev": "firebase deploy --project develop --only functions",
    "deploy:rules:dev": "firebase deploy --project develop --only firestore:rules",
    "// --- 獨立的部署指令 (生產環境) ---": "",
    "deploy:hosting:prod": "firebase deploy --project production --only hosting:production",
    "deploy:functions:prod": "firebase deploy --project production --only functions",
    "deploy:rules:prod": "firebase deploy --project production --only firestore:rules",
    "// --- ✨✨ 一鍵部署套餐 (已修正且更安全) ✨✨ ---": "",
    "deploy:dev": "npm-run-all build:dev deploy:hosting:dev deploy:functions:dev deploy:rules:dev",
    "deploy:prod": "npm-run-all build deploy:hosting:prod deploy:functions:prod deploy:rules:prod",
    "// --- 其他工具 ---": "",
    "run:init-schedules": "firebase functions:scheduler:run initializefutureschedules --project develop"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^9.22.0",
    "eslint-plugin-vue": "~10.0.0",
    "globals": "^16.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "3.5.3",
    "vite": "^6.2.4",
    "vite-plugin-vue-devtools": "^7.7.2"
  }
}
