{
  "name": "dialysis-app-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode production",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "// --- 獨立的、精準的部署指令 (用於單獨更新) ---": "",
    "deploy:hosting:prod": "firebase deploy --only hosting:production",
    "deploy:hosting:dev": "firebase deploy --only hosting:develop",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "// --- 推薦使用的一鍵部署套餐 ---": "",
    "deploy:prod": "run-s build deploy:hosting:prod deploy:functions",
    "deploy:dev": "run-s build:dev deploy:hosting:dev"
  },
  "dependencies": {
    "firebase": "^11.9.1",
    "firebase-admin": "^13.4.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^9.22.0",
    "eslint-plugin-vue": "~10.0.0",
    "globals": "^16.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "3.5.3",
    "vite": "^6.2.4",
    "vite-plugin-vue-devtools": "^7.7.2"
  }
}
