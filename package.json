{
  "name": "dialysis-app-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "//": "主要的 'build' 指令用於生產環境",
    "build": "vite build --mode production",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "//": "--- 專門用於開發環境的建置指令 ---",
    "build:dev": "vite build --mode development",
    "//": "--- 完整的部署流程 ---",
    "deploy:prod": "npm run build && firebase deploy --only hosting:production",
    "deploy:dev": "npm run build:dev && firebase deploy --only hosting:develop"
  },
  "dependencies": {
    "firebase": "^11.9.1",
    "firebase-admin": "^13.4.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^9.22.0",
    "eslint-plugin-vue": "~10.0.0",
    "globals": "^16.0.0",
    "prettier": "3.5.3",
    "vite": "^6.2.4",
    "vite-plugin-vue-devtools": "^7.7.2"
  }
}
