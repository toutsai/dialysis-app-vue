{
  "hosting": [
    {
      "target": "production",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          // 【核心修正點 1】: 修改 production 目標的 source
          "source": "!{**.*,/__/*}",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "develop",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          // 【核心修正點 2】: 修改 develop 目標的 source
          "source": "!{**.*,/__/*}",
          "destination": "/index.html"
        }
      ]
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local"]
    }
  ]
}
